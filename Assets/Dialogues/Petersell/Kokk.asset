  npcName: Phytalos
  npcPortrait: {fileID: 0}
  dialogueLines:
  - "Hei! Petersell on \xFCks mu k\xF6\xF6gi t\xE4httaimi! T\xE4nap\xE4eval kasutatakse
    seda igal pool \u2014 v\xE4rsketes salatites, suppides, pastades, isegi v\xF5ileibadel.
    See lisab v\xE4rskust ja maitset, aga magustoidus? Nalja teed v\xF5i?"
  - "Aga kas sa kuulasid mind? Kuidas kasutatakse peterselli t\xE4nap\xE4eva toiduvalmistamises?"
  - "Huvitav arvamus, aga see ei vasta p\xE4ris t\xF5ele. Proovi uuesti ja kuula
    hoolega vihjeid."
  - "Just! Ilma petersellita oleksid paljud toidud lihtsalt igavad. H\xE4sti tehtud!"
  - "Aga n\xFC\xFCd otsi Agaristet. Tema tunneb vanu uskumusi paremini kui keegi
    teine."
  typingSpeed: 0.05
  voiceSound: {fileID: 0}
  voicePitch: 1
  autoProgressLines: 
  endDialogueLines: 
  autoProgressDelay: 1.5
  plantGiver: 0
  choices:
  - dialogueIndex: 1
    choices:
    - "Seda kasutatakse paljudes roogades \u2013 salatites, suppides ja pastades."
    - "Seda kasvatatakse ainult dekoratsiooniks, mitte s\xF6\xF6giks."
    - ' Seda lisatakse kookidele ja magustoitudele.'
