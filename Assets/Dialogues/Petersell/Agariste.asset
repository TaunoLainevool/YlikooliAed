  npcName: Agariste
  npcPortrait: {fileID: 21300000, guid: 2f59a131136b64846bb2476478f369ce, type: 3}
  dialogueLines:
  - "Keskajal usuti, et petersell oli v\xE4ga eriline taim. Teda ei saanud kasvatada
    iga\xFCks \u2014 vaid need, kel oli erilist sidet looduse v\xF5i eluandmisega.
    Rahvajuttudes kasvatavad peterselli just n\xF5iad ja rasedad naised."
  - "Kellel \xF5nnestus keskajal uskumuste j\xE4rgi peterselli kasvatada?"
  - "See polnud p\xE4ris see, mida otsime. Kuula t\xE4helepanelikumalt ja proovi
    uuesti."
  - "\xD5ige! Ainult erilised inimesed suutsid seda \u2013 ja sina n\xE4id samuti
    olevat \xFCks neist."
  typingSpeed: 0.05
  voiceSound: {fileID: 0}
  voicePitch: 1
  autoProgressLines: 
  endDialogueLines: 
  autoProgressDelay: 1.5
  plantGiver: 1
  choices:
  - dialogueIndex: 1
    choices:
    - "N\xF5iad ja rasedad naised "
    - "Need, kes lugesid enne k\xFClvamist loitse"
    - Ravitsejad ja preestrid
    - Need, kes istutasid igal aastaajal
